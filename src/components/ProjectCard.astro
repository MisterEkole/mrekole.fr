---
interface Props {
  name: string;
  description: string;
  url: string;
  stars: number;
  language: string | null;
  updatedAt: string;
}

const { name, description, url, stars, language, updatedAt } = Astro.props;

const languageColors: Record<string, string> = {
  'C++': '#f34b7d',
  Rust: '#dea584',
  Python: '#3572A5',
  TypeScript: '#3178c6',
  JavaScript: '#f1e05a',
  C: '#555555',
  HTML: '#e34c26',
  Shell: '#89e051',
};

const timeAgo = (dateStr: string) => {
  const diff = Date.now() - new Date(dateStr).getTime();
  const days = Math.floor(diff / 86400000);
  if (days < 1) return 'today';
  if (days < 7) return `${days}d ago`;
  if (days < 30) return `${Math.floor(days / 7)}w ago`;
  if (days < 365) return `${Math.floor(days / 30)}mo ago`;
  return `${Math.floor(days / 365)}y ago`;
};
---

<a href={url} target="_blank" rel="noopener noreferrer" class="project-card">
  <div class="project-card__header">
    <svg class="project-card__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
    </svg>
    <h4 class="project-card__name mono">{name}</h4>
  </div>

  {description && <p class="project-card__desc">{description}</p>}

  <div class="project-card__meta">
    {language && (
      <span class="project-card__lang">
        <span class="project-card__dot" style={`background: ${languageColors[language] || 'var(--accent)'}`}></span>
        {language}
      </span>
    )}
    {stars > 0 && (
      <span class="project-card__stars">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        {stars}
      </span>
    )}
    <span class="project-card__updated">Updated {timeAgo(updatedAt)}</span>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-primary);
    transition: transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .project-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .project-card__icon {
    color: var(--text-tertiary);
    flex-shrink: 0;
  }

  .project-card__name {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .project-card__desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: auto;
    padding-top: var(--space-sm);
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .project-card__lang {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .project-card__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .project-card__stars {
    display: flex;
    align-items: center;
    gap: 3px;
  }
</style>
