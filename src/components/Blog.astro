---
import BlogCard from './BlogCard.astro';
import { XMLParser } from 'fast-xml-parser';

interface BlogPost {
  title: string;
  link: string;
  pubDate: string;
  excerpt: string;
}

let posts: BlogPost[] = [];

try {
  const res = await fetch('https://misterekole.substack.com/feed');
  if (res.ok) {
    const xml = await res.text();
    const parser = new XMLParser({
      ignoreAttributes: false,
      attributeNamePrefix: '@_',
    });
    const feed = parser.parse(xml);
    const items = feed?.rss?.channel?.item || [];
    const itemList = Array.isArray(items) ? items : [items];

    posts = itemList.slice(0, 6).map((item: any) => {
      // Strip HTML tags for excerpt
      const desc = (item.description || item['content:encoded'] || '')
        .replace(/<[^>]*>/g, '')
        .replace(/&nbsp;/g, ' ')
        .trim();
      const excerpt = desc.length > 160 ? desc.slice(0, 160) + '...' : desc;

      return {
        title: item.title || 'Untitled',
        link: item.link || '#',
        pubDate: item.pubDate || '',
        excerpt,
      };
    });
  }
} catch (e) {
  // Graceful fallback
}
---

<section class="blog section" id="blog">
  <div class="container">
    <div data-animate>
      <p class="section-label mono">Blog</p>
      <h2 class="section-title">Latest writing</h2>
      <p class="section-subtitle">
        Thoughts on engineering, technology, and the world around us.
      </p>
    </div>

    {posts.length > 0 ? (
      <div class="blog__grid">
        {posts.map((post, idx) => (
          <div data-animate data-animate-delay={String(Math.min(idx + 1, 5))}>
            <BlogCard
              title={post.title}
              link={post.link}
              pubDate={post.pubDate}
              excerpt={post.excerpt}
            />
          </div>
        ))}
      </div>
    ) : (
      <p class="blog__empty" data-animate>Articles coming soon. Check back later!</p>
    )}

    <div class="blog__cta" data-animate>
      <a
        href="https://misterekole.substack.com"
        target="_blank"
        rel="noopener noreferrer"
        class="blog__substack-link"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
        </svg>
        Read more on Substack
      </a>
    </div>
  </div>
</section>

<style>
  .section-label {
    font-size: 0.875rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-sm);
    font-weight: 500;
  }

  .blog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-xl);
    margin-bottom: var(--space-3xl);
  }

  .blog__empty {
    color: var(--text-tertiary);
    text-align: center;
    padding: var(--space-4xl) 0;
  }

  .blog__cta {
    text-align: center;
  }

  .blog__substack-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .blog__substack-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  @media (max-width: 480px) {
    .blog__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
