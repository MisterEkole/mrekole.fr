---
interface Props {
  name: string;
  repo: string;
  description: string;
  techStack: string[];
  highlights: string[];
  stars?: number;
  language?: string;
}

const { name, repo, description, techStack, highlights, stars, language } = Astro.props;

const languageColors: Record<string, string> = {
  'C++': '#f34b7d',
  Rust: '#dea584',
  Python: '#3572A5',
  TypeScript: '#3178c6',
  JavaScript: '#f1e05a',
};
---

<a href={`https://github.com/${repo}`} target="_blank" rel="noopener noreferrer" class="featured-project">
  <div class="featured-project__header">
    <div class="featured-project__name-row">
      <svg class="featured-project__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
      </svg>
      <h3 class="featured-project__name mono">{name}</h3>
    </div>
    {stars !== undefined && stars > 0 && (
      <span class="featured-project__stars">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        {stars}
      </span>
    )}
  </div>

  <p class="featured-project__description">{description}</p>

  <ul class="featured-project__highlights">
    {highlights.map((h) => (
      <li>{h}</li>
    ))}
  </ul>

  <div class="featured-project__footer">
    <div class="featured-project__tech">
      {techStack.map((tech) => (
        <span class="featured-project__tech-tag">{tech}</span>
      ))}
    </div>
    {language && (
      <div class="featured-project__language">
        <span class="featured-project__lang-dot" style={`background: ${languageColors[language] || 'var(--accent)'}`}></span>
        <span>{language}</span>
      </div>
    )}
  </div>

  <span class="featured-project__arrow">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="7" y1="17" x2="17" y2="7"/>
      <polyline points="7 7 17 7 17 17"/>
    </svg>
  </span>
</a>

<style>
  .featured-project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-xl);
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
    text-decoration: none;
    color: var(--text-primary);
    transition: transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
    overflow: hidden;
  }

  .featured-project:hover {
    transform: translateY(-4px);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--accent);
    color: var(--text-primary);
  }

  .featured-project__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .featured-project__name-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .featured-project__icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  .featured-project__name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .featured-project__stars {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--text-tertiary);
    font-size: 0.8125rem;
  }

  .featured-project__description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .featured-project__highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .featured-project__highlights li {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    padding-left: 1rem;
    position: relative;
  }

  .featured-project__highlights li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .featured-project__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }

  .featured-project__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .featured-project__tech-tag {
    font-size: 0.75rem;
    padding: 2px 8px;
    background: var(--tag-bg);
    color: var(--tag-text);
    border-radius: 100px;
    border: 1px solid var(--border);
  }

  .featured-project__language {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .featured-project__lang-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .featured-project__arrow {
    position: absolute;
    top: var(--space-xl);
    right: var(--space-xl);
    color: var(--text-tertiary);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .featured-project:hover .featured-project__arrow {
    opacity: 1;
    transform: translate(0, 0);
  }
</style>
