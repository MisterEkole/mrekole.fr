---
interface Props {
  title: string;
  link: string;
  pubDate: string;
  excerpt: string;
}

const { title, link, pubDate, excerpt } = Astro.props;

const formatDate = (dateStr: string) => {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<a href={link} target="_blank" rel="noopener noreferrer" class="blog-card">
  <div class="blog-card__content">
    <time class="blog-card__date mono" datetime={pubDate}>
      {formatDate(pubDate)}
    </time>
    <h3 class="blog-card__title">{title}</h3>
    <p class="blog-card__excerpt">{excerpt}</p>
  </div>
  <div class="blog-card__footer">
    <span class="blog-card__read">Read article</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="12 5 19 12 12 19"/>
    </svg>
  </div>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
    text-decoration: none;
    color: var(--text-primary);
    transition: transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .blog-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .blog-card__date {
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  .blog-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__excerpt {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__footer {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--accent);
    font-weight: 500;
  }

  .blog-card__footer svg {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .blog-card:hover .blog-card__footer svg {
    transform: translateX(4px);
  }
</style>
